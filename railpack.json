{
    "$schema": "https://schema.railpack.com",
    "provider": "php",
    "packages": {
        "node": "24"
    },
    "buildAptPackages": [
        "supervisor"
    ],
    "steps": {
        "extensions": {
            "deployOutputs": [],
            "commands": [
                "...",
                "install-php-extensions bcmath exif gd intl pcntl pdo_mysql redis zip",
                {
                    "src": "php-overrides.ini",
                    "dest": "/usr/local/etc/php/conf.d/zz-scrimora.ini"
                },
                "setcap -r /usr/local/bin/frankenphp"
            ]
        },
        "build": {
            "commands": [
                "mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs bootstrap/cache",
                "composer dump-autoload --optimize --no-interaction",
                "pnpm run build:ssr",
                "rm -f bootstrap/cache/config.php bootstrap/cache/events.php bootstrap/cache/routes-*.php"
            ]
        },
        "install:node": {
            "deployOutputs": [],
            "commands": [
                {
                    "src": "package.json",
                    "dest": "package.json"
                },
                "npm i -g corepack@latest && corepack enable && corepack prepare --activate",
                "pnpm install --no-frozen-lockfile"
            ]
        },
        "install:composer": {
            "deployOutputs": [],
            "variables": {
                "COMPOSER_NO_DEV": "1"
            }
        },
        "prepare": {
            "inputs": [
                {
                    "image": "dunglas/frankenphp:php8.4.27-bookworm"
                }
            ],
            "deployOutputs": [],
            "commands": [
                "apt-get update && apt-get install -y git zip unzip ca-certificates",
                "..."
            ]
        }
    },
    "deploy": {
        "startCommand": "bash /app/start-container.sh",
        "inputs": [
            "...",
            {
                "step": "packages:mise",
                "include": [
                    "/mise/shims",
                    "/mise/installs",
                    "/usr/local/bin/mise",
                    "/etc/mise/config.toml"
                ]
            }
        ],
        "paths": [
            "/mise/shims"
        ],
        "variables": {
            "MISE_STATE_DIR": "/tmp/mise-state",
            "PORT": "8081"
        }
    }
}
